{
  "name": "dsh-goal-ledger",
  "version": "0.4.1",
  "description": "Goal-distance ledger and failure-cluster panel for DeepSeek Harness — audits your own sessions, shows where goals drifted and where tool calls actually failed.",
  "type": "module",
  "license": "MIT",
  "author": "zhangruixiong <1393849546@qq.com>",
  "homepage": "https://github.com/zhegemingzimeibanquan/dsh-goal-ledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhegemingzimeibanquan/dsh-goal-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/zhegemingzimeibanquan/dsh-goal-ledger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-goal-ledger",
    "observability",
    "session-audit",
    "goal-distance",
    "failure-clustering",
    "drift-detection"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./market-index.json": "./market-index.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "market-index.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:render": "node test/client-render.mjs",
    "test:correction": "node test/correction.mjs && node test/correction-wiring.mjs",
    "test:full": "node test/full.mjs",
    "test:render-field": "node test/render-field.mjs",
    "test:links": "node test/links.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check src/session-reader.js && node --check src/failure-cluster.js && node --check src/embed-config.js && node --check src/correction.js && node --check src/distance.js",
    "test:manifest": "node test/manifest.mjs",
    "test:published": "node test/published-matches-tag.mjs",
    "test:labels": "node test/label-collisions.mjs",
    "test:bearing": "node test/bearing-cost.mjs",
    "test:field": "node test/field-layers.mjs",
    "test:section": "node test/section-mount.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  }
}
